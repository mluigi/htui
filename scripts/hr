#!/usr/bin/env bash
# hr — host driver for containerized /handoff-run sandboxes (TOOL-7). One run = one docker compose
# project `hr-<item>` (docker/hr/compose.hr.yaml): a fresh clone of this repo on branch hr/<ITEM>,
# a private Postgres + Qdrant, and the htui-hr-dev toolchain image. Work leaves a sandbox only when
# the maintainer collects it here, on the host; nothing is ever pushed.
#
# Usage:
#   scripts/hr                                   # gum menu (terminal only)
#   scripts/hr build
#   scripts/hr up [ITEM] [--ssd] [--from REF] [--cpus N] [--yes]
#   scripts/hr attach [ITEM] [--shell]
#   scripts/hr ls [--tsv]
#   scripts/hr collect ITEM [--merge] [--force] [--yes]
#   scripts/hr down ITEM [--purge] [--force] [--yes]
#   scripts/hr gc [--yes]
#
# Interaction uses gum (terminal only); every verb also takes plain arguments. Without a terminal a
# missing choice is a usage error and a confirmation needs --yes.
#
# Environment (all optional):
#   HR_ROOT       run dirs on the HDD        (default /media/projects/htui-hr)
#   HR_SSD_ROOT   run dirs with `up --ssd`   (default ~/htui-hr)
#   HR_STATE      ID leases, shared rw with every sandbox (default /media/projects/htui-hr/.state)
#   HR_RUNS       run registry, host-only    (default /media/projects/htui-hr/.runs; never mounted)
#   HR_HOST_REPO  host repo main worktree    (default: the main worktree of this script's repo)
#   HR_IMAGE      toolchain image tag        (default htui-hr-dev)
#   HR_MISE_PATH  PATH dirs for claude/uv/rg inside the sandbox (default: resolved from mise)
#   HR_DOCKER     docker binary              (default docker; the tests stub it)
#   HR_INTERACTIVE  auto (default: stdin and stdout are terminals) | 1 | 0
#   HR_NO_GUM=1   behave as if gum were not installed
# Everything scripts/hr exports to compose is the env contract in the header of
# docker/hr/compose.hr.yaml (blueprint §T1).
#
# Exit codes: 0 ok, 1 refused (duplicate run, item not open, dirty tree, non-fast-forward,
#             uncollected, conflict, no confirmation), 2 usage / missing dependency,
#             3 external failure (docker, git clone/fetch, IO).
#
# Run registry $HR_RUNS/<ITEM> (owned by this script; key=value, written tmp+mv under flock
# $HR_RUNS/.lock, parsed and validated, never sourced). HR_RUNS is host-only: the registry names
# what gets mounted rw and what `down -v` removes, so no sandbox may write it (review H4); a
# registry left in the old place, $HR_STATE/runs, is moved there once per state dir (recorded in
# $HR_RUNS/.migrated), and never read again after that (re-review M-B). ID leases belong to
# scripts/hr-mint alone; $HR_RUNS/.leases-initialized records (host-only) that a state dir had
# leasing on, so a lease file a sandbox deleted is refused rather than silently recreated.
# Design: .claude/plans/tool-7-hr-sandbox.plan.md, blueprint §T4. Linux only.

set -u

case "$(uname -s 2>/dev/null || echo unknown)" in
    Linux) ;;
    *) echo "hr: Linux-only (TOOL-7 sandboxes need Docker on a Linux host)" >&2; exit 2 ;;
esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF_ROOT="$(readlink -f "$SCRIPT_DIR/..")"
SELF="$SELF_ROOT/scripts/hr"
COMPOSE_FILE="$SELF_ROOT/docker/hr/compose.hr.yaml"
HR_MINT_BIN="$SELF_ROOT/scripts/hr-mint"
WF_DIR="$SELF_ROOT/.claude/skills/handoff-run/scripts"
# Sourced once, at start, from the checkout hr runs from — before any `collect --merge` can change
# it. The validator a merge runs is taken from the pre-merge HEAD instead (review H6).
# shellcheck source=../.claude/skills/handoff-run/scripts/workflow-patterns.sh
source "$WF_DIR/workflow-patterns.sh"

DOCKER="${HR_DOCKER:-docker}"
IMAGE="${HR_IMAGE:-htui-hr-dev}"
DEFAULT_STATE=/media/projects/htui-hr/.state
STATE="$(realpath -ms "${HR_STATE:-$DEFAULT_STATE}")"
RUNS="$(realpath -ms "${HR_RUNS:-/media/projects/htui-hr/.runs}")"
RUNS_LOCK="$RUNS/.lock"
LEASE_MARK="$RUNS/.leases-initialized"
MIGRATED_MARK="$RUNS/.migrated"
OLD_RUNS="$STATE/runs"
ROOT_HDD="$(realpath -ms "${HR_ROOT:-/media/projects/htui-hr}")"
ROOT_SSD="$(realpath -ms "${HR_SSD_ROOT:-$HOME/htui-hr}")"
CARGO_VOLUME=htui-hr-cargo
TAB=$'\t'
REG_HEADER='# hr run registry v1 - owner: scripts/hr'
REG_KEYS=(item project branch run_dir root_kind base_ref base_sha cpus created_at collected_sha collected_at)
ITEM_RE="^(${ID_ALT})\$"

HOST=''
SRC=''
PROJECT=''
COMPOSE=()
declare -A RUN=()

# ---- output / interaction ----

die() { # $1=exit code, rest=message
    local rc="$1"
    shift
    echo "hr: $*" >&2
    exit "$rc"
}
warn() { echo "hr: $*" >&2; }

usage() {
    cat <<'EOF'
Usage: scripts/hr                       (gum menu; terminal only)
       scripts/hr build
       scripts/hr up [ITEM] [--ssd] [--from REF] [--cpus N] [--yes]
       scripts/hr attach [ITEM] [--shell]
       scripts/hr ls [--tsv]
       scripts/hr collect ITEM [--merge] [--force] [--yes]
       scripts/hr down ITEM [--purge] [--force] [--yes]
       scripts/hr gc [--yes]
User guide: docs/hr-sandbox.md
EOF
}

usage_die() {
    [[ $# -gt 0 ]] && echo "hr: $*" >&2
    usage >&2
    exit 2
}

interactive() {
    case "${HR_INTERACTIVE:-auto}" in
        1 | yes | true) return 0 ;;
        0 | no | false) return 1 ;;
        *) [[ -t 0 && -t 1 ]] ;;
    esac
}

have_gum() {
    [[ -z "${HR_NO_GUM:-}" || "${HR_NO_GUM}" == 0 ]] && command -v gum >/dev/null 2>&1
}

need_gum() {
    have_gum || die 2 "gum not found (apt install gum) — or pass the arguments"
}

# gum for display only when a person is watching and gum is there; plain otherwise.
fancy() { interactive && have_gum; }

# spin TITLE CMD... — gum spinner in a terminal, the plain command otherwise.
spin() {
    local title="$1"
    shift
    if fancy; then
        gum spin --show-error --title "$title" -- "$@"
    else
        "$@"
    fi
}

# confirm YES PROMPT — 0 when confirmed. YES=1 (--yes) skips the question; without a terminal
# a confirmation is refused (exit 1) rather than assumed.
confirm() {
    local yes="$1" prompt="$2"
    [[ "$yes" -eq 1 ]] && return 0
    interactive || die 1 "needs confirmation: pass --yes (or run it in a terminal) — $prompt"
    need_gum
    gum confirm "$prompt"
}

now_utc() { date -u +%FT%TZ; }

# ---- host repo / git ----

# The host repo: HR_HOST_REPO, else the main worktree of this script's repo (a linked worktree's
# common dir is the main one's .git).
host_repo() {
    [[ -n "$HOST" ]] && return 0
    if [[ -n "${HR_HOST_REPO:-}" ]]; then
        HOST="$(realpath -ms "$HR_HOST_REPO")"
    else
        local common
        common="$(git -C "$SELF_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
            || die 2 "cannot find the host repo from $SELF_ROOT (set HR_HOST_REPO)"
        HOST="$(dirname "$common")"
    fi
    git -C "$HOST" rev-parse --git-dir >/dev/null 2>&1 || die 2 "host repo $HOST is not a git repository"
}

# clone_ok — the run's clone has a real .git directory (not a symlink a sandbox planted, not a
# gitdir file pointing elsewhere).
clone_ok() {
    [[ -d "$SRC/.git" && ! -L "$SRC/.git" ]]
}

# Every host-side git call on a clone goes through here, and only ref/object plumbing is allowed:
# the clone's .git (config, info/attributes, hooks, modules/) is writable from the sandbox, and
# anything that reads its worktree (status, diff, checkout...) runs the filters, fsmonitor and
# hooks it names. Those run in a throwaway container instead (clone_status_check; F14, review H3).
# --git-dir (no worktree), fsmonitor/hooks/untracked cache off as a second fence.
src_git() {
    case "${1:-}" in
        rev-parse | for-each-ref | cat-file | merge-base | rev-list) ;;
        worktree) [[ "${2:-}" == list ]] || die 3 "internal: git worktree ${2:-} on a clone is not allowed on the host" ;;
        *) die 3 "internal: git ${1:-} on a clone is not allowed on the host (it may run the sandbox's filters)" ;;
    esac
    clone_ok || { warn "$SRC/.git is missing or not a directory"; return 1; }
    git --no-pager --git-dir="$SRC/.git" -c core.fsmonitor=false -c core.hooksPath=/dev/null \
        -c core.untrackedCache=false "$@"
}

# clone_git ARGS — `up` only: git on the clone this process has just created, before any
# container has seen it (its config and hooks are still git clone's own).
clone_git() {
    git --no-pager -C "$SRC" "$@"
}

# Runs inside the throwaway container of clone_status_check: git status in every worktree of the
# clone (main + in-run linked ones), with the clone mounted at its in-sandbox path ($1), so the
# worktree paths recorded inside the sandbox are valid. Untracked non-ignored files count
# (-unormal); linked worktrees are checked on their own and excluded from the main one's status.
# Exit 0 clean, 1 dirty or not checkable; findings on stdout.
# shellcheck disable=SC2016
CHECK_SCRIPT='root=$1 rc=0 wt="" out=""
err=$(mktemp) || exit 2
list=$(git worktree list --porcelain) || { echo "cannot list the clone'"'"'s worktrees"; exit 2; }
excl=()
while IFS= read -r line; do
    case $line in "worktree $root"/*) excl+=(":(exclude,literal)${line#"worktree $root"/}") ;; esac
done <<<"$list"
while IFS= read -r line; do
    case $line in "worktree "*) wt=${line#worktree } ;; *) continue ;; esac
    spec=()
    case $wt in
        "$root") spec=(-- . "${excl[@]}") ;;
        "$root"/*) ;;
        *) echo "worktree $wt is outside the clone: it cannot be checked"; rc=1; continue ;;
    esac
    if [ ! -d "$wt" ]; then
        echo "worktree $wt is missing (git worktree prune inside the sandbox)"; rc=1; continue
    fi
    if ! out=$(cd "$wt" && timeout 240 git --no-optional-locks status --porcelain -unormal --ignore-submodules=all "${spec[@]}" 2>"$err"); then
        echo "git status failed in $wt:"; sed "s/^/  /" "$err"; rc=1; continue
    fi
    if [ -n "$out" ]; then
        echo "uncommitted changes in $wt:"; printf "%s\n" "$out" | sed "s/^/  /"; rc=1
    fi
done <<<"$list"
exit $rc'

# clone_status_check — git status of the clone's worktrees, never on the host: a throwaway
# container of the toolchain image (no network, no capabilities, clone read-only, host uid), so
# whatever the sandbox's config makes git execute stays in there (review H3). Prints findings;
# 0 clean, 1 dirty or unverifiable (any failure fails closed). After load_run.
clone_status_check() {
    local name="hr-check-${PROJECT#hr-}-$$" out rc
    out="$(timeout 300 "$DOCKER" run --rm --pull never --name "$name" --network none --cap-drop ALL \
        --security-opt no-new-privileges -u "$(id -u):$(id -g)" -v "$SRC:$HOST:ro" -w "$HOST" \
        --entrypoint bash "$IMAGE" -c "$CHECK_SCRIPT" hr-check "$HOST" 2>&1)"
    rc=$?
    case "$rc" in
        0) return 0 ;;
        1) printf '%s\n' "$out" ;;
        124) "$DOCKER" rm -f "$name" >/dev/null 2>&1
             printf 'the status check timed out after 300 s\n' ;;
        *) printf 'the status check failed (docker run exit %s):\n%s\n' "$rc" "$out" ;;
    esac
    return 1
}

# no_ctl — stdin to stdout without control characters (newlines kept): text a sandbox or a
# HANDOFF line wrote must not reach the terminal as escape sequences.
no_ctl() {
    LC_ALL=C sed 's/[[:cntrl:]]//g'
}

# open_items SHA — "ID<TAB>title" for every open checklist line of HANDOFF.md at SHA.
# Prefixes from workflow-patterns.sh (PREFIX_ALT); titles lose control characters.
open_items() {
    git -C "$HOST" cat-file blob "$1:HANDOFF.md" 2>/dev/null \
        | LC_ALL=C sed -nE "s/^- \\[ \\] \\*\\*((${PREFIX_ALT})-[0-9]+) - ([^*]*).*/\\1\t\\3/p" \
        | LC_ALL=C sed 's/[\x01-\x08\x0b-\x1f\x7f]//g'
}

global_ignore_file() {
    local f
    f="$(git config --global --path core.excludesFile 2>/dev/null)"
    [[ -n "$f" ]] || f="${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"
    printf '%s' "$f"
}

# ---- run registry ----

registered_items() {
    local f
    [[ -d "$RUNS" ]] || return 0
    for f in "$RUNS"/*; do
        [[ -e "$f" || -L "$f" ]] || continue
        f="${f##*/}"
        [[ "$f" =~ $ITEM_RE ]] && printf '%s\n' "$f"
    done
}

# read_reg ITEM — fill RUN[] from the registry file and validate every field; 1 if there is none,
# exit 3 on anything this script would not have written (review H4). RUN[run_dir] comes back
# normalised to exactly $HR_ROOT/ITEM or $HR_SSD_ROOT/ITEM.
read_reg() {
    local item="$1" file="$RUNS/$1" k v first=1
    [[ -e "$file" || -L "$file" ]] || return 1
    reg_bad() { die 3 "registry $file is invalid: $* — fix or remove it by hand (scripts/hr never writes that)"; }
    [[ -f "$file" && ! -L "$file" ]] || reg_bad "not a regular file"
    RUN=()
    while IFS= read -r k || [[ -n "$k" ]]; do
        if [[ "$first" -eq 1 ]]; then
            [[ "$k" == "$REG_HEADER" ]] || reg_bad "missing header line"
            first=0
            continue
        fi
        [[ -z "$k" ]] && continue
        [[ "$k" == *[[:cntrl:]]* ]] && reg_bad "control characters"
        [[ "$k" == '#'* ]] && continue
        [[ "$k" == *=* ]] || reg_bad "line without '='"
        v="${k#*=}"
        k="${k%%=*}"
        case " ${REG_KEYS[*]} " in
            *" $k "*) [[ -z "${RUN[$k]+x}" ]] || reg_bad "duplicate key $k"; RUN[$k]="$v" ;;
            *) reg_bad "unknown key '$k'" ;;
        esac
    done <"$file"
    [[ "$first" -eq 0 ]] || reg_bad "empty"
    for k in "${REG_KEYS[@]}"; do
        [[ -n "${RUN[$k]+x}" ]] || reg_bad "missing key $k"
    done
    local sha_re='^[0-9a-f]{40}([0-9a-f]{24})?$' ts_re='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
    [[ "${RUN[item]}" == "$item" && "$item" =~ $ITEM_RE ]] || reg_bad "item '${RUN[item]}' is not $item"
    [[ "${RUN[project]}" == "hr-${item,,}" ]] || reg_bad "project '${RUN[project]}' is not hr-${item,,}"
    [[ "${RUN[branch]}" == "hr/$item" ]] || reg_bad "branch '${RUN[branch]}' is not hr/$item"
    local root
    case "${RUN[root_kind]}" in
        hdd) root="$ROOT_HDD" ;;
        ssd) root="$ROOT_SSD" ;;
        *) reg_bad "root_kind '${RUN[root_kind]}' is not hdd or ssd" ;;
    esac
    [[ -n "${RUN[run_dir]}" && "$(realpath -ms -- "${RUN[run_dir]}")" == "$root/$item" ]] \
        || reg_bad "run_dir '${RUN[run_dir]}' is not $root/$item (${RUN[root_kind]} root; HR_ROOT / HR_SSD_ROOT changed?)"
    RUN[run_dir]="$root/$item"
    [[ "${RUN[cpus]}" =~ ^[0-9]+(\.[0-9]+)?$ && ! "${RUN[cpus]}" =~ ^0+(\.0+)?$ ]] || reg_bad "cpus '${RUN[cpus]}' is not a positive number"
    [[ "${RUN[base_sha]}" =~ $sha_re ]] || reg_bad "base_sha '${RUN[base_sha]}' is not a commit id"
    [[ -n "${RUN[base_ref]}" ]] || reg_bad "empty base_ref"
    [[ "${RUN[created_at]}" =~ $ts_re ]] || reg_bad "created_at '${RUN[created_at]}' is not a UTC timestamp"
    [[ -z "${RUN[collected_sha]}" || "${RUN[collected_sha]}" =~ $sha_re ]] || reg_bad "collected_sha '${RUN[collected_sha]}' is not a commit id"
    [[ -z "${RUN[collected_at]}" || "${RUN[collected_at]}" =~ $ts_re ]] || reg_bad "collected_at '${RUN[collected_at]}' is not a UTC timestamp"
    return 0
}

# write_reg ITEM — RUN[] to the registry file, tmp + mv. Caller holds the runs lock.
write_reg() {
    local file="$RUNS/$1" tmp k
    tmp="$RUNS/.$1.tmp.$$"
    {
        printf '%s\n' "$REG_HEADER"
        for k in "${REG_KEYS[@]}"; do printf '%s=%s\n' "$k" "${RUN[$k]:-}"; done
    } >"$tmp" 2>/dev/null && mv -f "$tmp" "$file" || {
        rm -f "$tmp"
        die 3 "cannot write $file"
    }
}

RUNS_FD=''
lock_runs() {
    [[ -n "$RUNS_FD" ]] && return 0
    mkdir -p "$RUNS" 2>/dev/null || die 3 "cannot create $RUNS"
    exec {RUNS_FD}>>"$RUNS_LOCK" || die 3 "cannot open $RUNS_LOCK"
    flock -w 30 "$RUNS_FD" || die 3 "timed out waiting for $RUNS_LOCK"
}
unlock_runs() {
    [[ -n "$RUNS_FD" ]] && exec {RUNS_FD}>&-
    RUNS_FD=''
}

# check_runs_dir — HR_RUNS must stay out of everything a sandbox mounts rw.
check_runs_dir() {
    case "$RUNS/" in
        "$STATE"/*) die 2 "HR_RUNS ($RUNS) must not be inside HR_STATE ($STATE): every sandbox mounts HR_STATE rw" ;;
    esac
}

# migrate_registry — a registry from before review H4 lived in $HR_STATE/runs, which every sandbox
# can write: move its entries to the host-only HR_RUNS (read_reg validates them like any other),
# once per state dir. $HR_RUNS/.migrated (host-only) records each state dir done; after that
# nothing is ever imported from $HR_STATE/runs again — a sandbox could plant entries there at any
# time (re-review M-B) — and whatever is there only draws one warning per call.
migrate_registry() {
    if grep -qxF -- "$STATE" "$MIGRATED_MARK" 2>/dev/null; then
        [[ -e "$OLD_RUNS" || -L "$OLD_RUNS" ]] \
            && warn "ignoring $OLD_RUNS: the registry moved to $RUNS already, nothing is imported from there any more (a sandbox can write it) — inspect and remove it by hand"
        return 0
    fi
    lock_runs
    if [[ ! -e "$OLD_RUNS" && ! -L "$OLD_RUNS" ]]; then
        mark_migrated
        unlock_runs
        return 0
    fi
    if [[ ! -d "$OLD_RUNS" || -L "$OLD_RUNS" ]]; then
        warn "ignoring $OLD_RUNS: not a directory (a sandbox?), nothing to import; the registry lives in $RUNS — inspect and remove it by hand"
        mark_migrated
        unlock_runs
        return 0
    fi
    local f name n=0 left=0
    for f in "$OLD_RUNS"/* "$OLD_RUNS"/.[!.]*; do
        [[ -e "$f" || -L "$f" ]] || continue
        name="${f##*/}"
        if [[ "$name" =~ $ITEM_RE && -f "$f" && ! -L "$f" ]]; then
            [[ -e "$RUNS/$name" || -L "$RUNS/$name" ]] \
                && die 3 "registry entry $name is in both $OLD_RUNS and $RUNS — keep one by hand"
            mv -- "$f" "$RUNS/$name" || die 3 "cannot move $f to $RUNS"
            n=$((n + 1))
        else
            left=$((left + 1))
        fi
    done
    rm -f -- "$STATE/runs.lock"
    if [[ "$left" -eq 0 ]]; then
        rmdir -- "$OLD_RUNS" 2>/dev/null || true
    else
        warn "left $OLD_RUNS in place: $left entries that are not registry files — inspect and remove it by hand"
    fi
    [[ "$n" -gt 0 ]] && warn "moved $n registry entries from $OLD_RUNS to the host-only $RUNS"
    mark_migrated
    unlock_runs
}

# mark_migrated — record (under the runs lock) that $STATE's old registry has been dealt with.
mark_migrated() {
    printf '%s\n' "$STATE" >>"$MIGRATED_MARK" || die 3 "cannot write $MIGRATED_MARK"
}

# ID leases: hr-mint --init creates the lease file on the host; the host-only marker then remembers
# it existed, because a sandbox can delete both the lease file and its lock (review M3).
lease_file_vanished() {
    [[ -f "$LEASE_MARK" ]] && grep -qxF -- "$STATE" "$LEASE_MARK" 2>/dev/null && [[ ! -e "$STATE/id-leases.tsv" ]]
}
check_leases() {
    lease_file_vanished || return 0
    die 1 "lease file $STATE/id-leases.tsv vanished (a sandbox or a stray rm?) — restore it, or run scripts/hr-mint --init --force after checking"
}
init_leases() {
    check_leases
    HR_STATE="$STATE" "$HR_MINT_BIN" --init || die 3 "scripts/hr-mint --init failed"
    grep -qxF -- "$STATE" "$LEASE_MARK" 2>/dev/null && return 0
    printf '%s\n' "$STATE" >>"$LEASE_MARK" || die 3 "cannot write $LEASE_MARK"
}

# set_reg ITEM k=v... — update registry fields under the lock.
set_reg() {
    local item="$1" kv
    shift
    lock_runs
    read_reg "$item" || { unlock_runs; die 1 "no registered run $item"; }
    for kv in "$@"; do RUN[${kv%%=*}]="${kv#*=}"; done
    write_reg "$item"
    unlock_runs
}

# ---- compose env (the contract in docker/hr/compose.hr.yaml) ----

# The only parts of ~/.local a sandbox sees (read-only); the rest holds secrets (review C1).
LOCAL_MOUNTS=("$HOME/.local/bin" "$HOME/.local/share/mise/installs" "$HOME/.local/share/uv/python"
    "$HOME/.local/share/uv/tools")

# What of ~/.claude a run does not see (re-review M-C; compose.hr.yaml masks them): directories
# get an empty tmpfs, files a per-run empty file from RUN_DIR/claude-mask. Everything else in
# ~/.claude stays shared read-write, and projects/<the run's project> is bound back.
CLAUDE_MASK_DIRS=(projects file-history paste-cache shell-snapshots session-env session-data sessions
    jobs daemon backups metrics .remember)
CLAUDE_MASK_FILES=(history.jsonl bash-commands.log cost-tracker.log)

# claude_project NAME_VAR — Claude Code's ~/.claude/projects/<name> for HOST (every character
# outside [A-Za-z0-9] becomes '-'; longer names than 200 get a hash suffix, not reproduced here).
claude_project() {
    local LC_ALL=C name="${HOST//[^a-zA-Z0-9]/-}"
    [[ ${#name} -le 200 ]] || die 2 "the host repo path $HOST is too long for Claude's project dir name (over 200 characters)"
    printf '%s' "$name"
}

# prepare_claude_mounts RUN_DIR — every mount point compose puts inside ~/.claude exists on the
# host, owned by the user (Docker would create a missing one root-owned in the host's ~/.claude);
# existing entries are left as they are. RUN_DIR/claude-mask holds the run's empty files.
prepare_claude_mounts() {
    local rd="$1" c="$HOME/.claude" d f
    mkdir -p "$c/projects/$HR_CLAUDE_PROJECT" || return 1
    for d in "${CLAUDE_MASK_DIRS[@]}"; do mkdir -p "$c/$d" || return 1; done
    for f in "${CLAUDE_MASK_FILES[@]}"; do
        [[ -e "$c/$f" || -L "$c/$f" ]] || (umask 077 && : >"$c/$f") || return 1
    done
    mkdir -p "$rd/claude-mask" || return 1
    for f in "${CLAUDE_MASK_FILES[@]}"; do
        [[ -f "$rd/claude-mask/$f" && ! -L "$rd/claude-mask/$f" ]] && continue
        rm -rf -- "${rd:?}/claude-mask/$f" && (umask 077 && : >"$rd/claude-mask/$f") || return 1
    done
}

# make_cargo_empty RUN_DIR — the empty read-only file compose binds over the shared cargo volume's
# config/credentials files (review M5). Outside src/, so the sandbox cannot write it.
make_cargo_empty() {
    local f="$1/cargo-empty"
    [[ -f "$f" && ! -L "$f" && ! -s "$f" ]] && return 0
    rm -f -- "$f" && : >"$f" && chmod 444 "$f"
}

# The shared cargo volume's mount points (compose.hr.yaml binds over them): the four files, and
# bin/, registry/, registry/src directories. Runs inside cargo_volume_check's container, with the
# volume read-only at $1; prints every name that is a symlink or of the wrong kind.
# shellcheck disable=SC2016
CARGO_CHECK_SCRIPT='v=$1
for n in config config.toml credentials credentials.toml; do
    if [ -L "$v/$n" ] || { [ -e "$v/$n" ] && [ ! -f "$v/$n" ]; }; then echo "$n"; fi
done
for n in bin registry registry/src; do
    if [ -L "$v/$n" ] || { [ -e "$v/$n" ] && [ ! -d "$v/$n" ]; }; then echo "$n"; fi
done'

# cargo_volume_ok — before compose creates a container: every mount point in the shared cargo
# volume is absent or of the kind compose mounts over it. A sandbox cannot swap one while it is
# mounted, but a wrong kind (config.toml turned into a directory, bin/ into a file or a symlink)
# would break every later `up` or send a mount elsewhere (re-review L8b). Fails, never repairs:
# the volume is shared, and a swapped mount point is a sign to look at, not to erase.
cargo_volume_ok() {
    local out rc
    out="$(timeout 120 "$DOCKER" run --rm --pull never --network none --cap-drop ALL \
        --security-opt no-new-privileges -u "$(id -u):$(id -g)" -v "$CARGO_VOLUME:/v:ro" \
        --entrypoint sh "$IMAGE" -c "$CARGO_CHECK_SCRIPT" hr-cargo-check /v 2>&1)"
    rc=$?
    [[ "$rc" -eq 0 ]] || die 3 "cannot check the shared cargo volume $CARGO_VOLUME (docker run exit $rc): $(no_ctl <<<"$out")"
    [[ -z "$out" ]] && return 0
    local n list=''
    while IFS= read -r n; do list+=" $n"; done < <(no_ctl <<<"$out")
    die 3 "the shared cargo volume $CARGO_VOLUME has the wrong kind of entry (or a symlink) where compose mounts:${list} — a sandbox replaced it. Inspect it, then remove it: docker run --rm -v $CARGO_VOLUME:/v --entrypoint rm $IMAGE -rf --$(printf ' /v/%s' ${list})"
}

# resolve_mise_path STRICT — HR_MISE_PATH unless preset: claude and uv (required; before the stale
# uv in ~/.local/bin), ripgrep (optional). Colon-joined, no trailing slashes. Never mise shims.
resolve_mise_path() {
    local strict="$1"
    if [[ -n "${HR_MISE_PATH:-}" ]]; then
        export HR_MISE_PATH
        return 0
    fi
    local m="$HOME/.local/share/mise/installs" d
    local -a parts=()
    if [[ -x "$m/claude/latest/claude" ]]; then
        parts+=("$m/claude/latest")
    elif [[ "$strict" -eq 1 ]]; then
        die 2 "claude not found at $m/claude/latest/claude (install it with mise, or set HR_MISE_PATH)"
    fi
    if [[ -x "$m/uv/latest/.mise-bins/uv" ]]; then
        parts+=("$m/uv/latest/.mise-bins")
    elif [[ "$strict" -eq 1 ]]; then
        die 2 "uv not found at $m/uv/latest/.mise-bins/uv (install it with mise, or set HR_MISE_PATH)"
    fi
    for d in "$m"/ripgrep/latest/ripgrep-*/; do
        [[ -d "$d" ]] && parts+=("${d%/}")
    done
    [[ ${#parts[@]} -gt 0 ]] || parts=(/usr/bin)
    local IFS=:
    export HR_MISE_PATH="${parts[*]}"
}

# host_env STRICT — the host-derived half of the contract. STRICT=1 (up, attach: containers may be
# created) refuses a missing git identity; otherwise (down, ps) placeholders keep compose parsing.
host_env() {
    local strict="$1"
    host_repo
    export HR_HOST_REPO="$HOST"
    export HR_HOME="$HOME"
    export HR_UID HR_GID
    HR_UID="$(id -u)"
    HR_GID="$(id -g)"
    export HR_STATE_HOST="$STATE"
    export HR_IMAGE="$IMAGE"
    local name email
    name="$(git -C "$HOST" config user.name 2>/dev/null)"
    email="$(git -C "$HOST" config user.email 2>/dev/null)"
    if [[ -z "$name" || -z "$email" ]]; then
        [[ "$strict" -eq 1 ]] && die 2 "git user.name / user.email not set for $HOST (the sandbox commits as that identity)"
        name="${name:-hr}"
        email="${email:-hr@localhost}"
    fi
    export HR_GIT_NAME="$name" HR_GIT_EMAIL="$email"
    HR_CLAUDE_PROJECT="$(claude_project)" || exit $?
    export HR_CLAUDE_PROJECT
    resolve_mise_path "$strict"
}

set_compose() { # $1=project
    PROJECT="$1"
    COMPOSE=("$DOCKER" compose -p "$PROJECT" -f "$COMPOSE_FILE")
}

# load_run ITEM STRICT — registry + env for an existing run.
load_run() {
    local item="$1" strict="${2:-0}"
    read_reg "$item" || die 1 "no registered run $item (scripts/hr ls)"
    host_env "$strict"
    export HR_ITEM="$item"
    export HR_SRC="${RUN[run_dir]}/src"
    export HR_CLAUDE_JSON="${RUN[run_dir]}/claude.json"
    export HR_CARGO_EMPTY="${RUN[run_dir]}/cargo-empty"
    export HR_CLAUDE_MASK="${RUN[run_dir]}/claude-mask"
    export HR_CPUS="${RUN[cpus]:-4}"
    SRC="$HR_SRC"
    set_compose "${RUN[project]:-hr-${item,,}}"
}

# dev_running — the run's dev container is up (compose ps; live state always from Docker).
dev_running() {
    [[ -n "$("${COMPOSE[@]}" ps --status running -q dev 2>/dev/null)" ]]
}

# is_collected ITEM — the clone's hr/ITEM tip is on the host, in hr/ITEM or in main. After
# load_run. A run with no commits passes (its tip is the base).
is_collected() {
    local item="$1" tip
    clone_ok || return 1
    tip="$(src_git rev-parse --verify -q "refs/heads/hr/$item^{commit}")" || return 1
    git -C "$HOST" cat-file -e "$tip^{commit}" 2>/dev/null || return 1
    git -C "$HOST" merge-base --is-ancestor "$tip" "refs/heads/hr/$item" 2>/dev/null && return 0
    git -C "$HOST" merge-base --is-ancestor "$tip" refs/heads/main 2>/dev/null
}

# pick_run HEADER — gum choice over registered runs (terminal only).
pick_run() {
    interactive || usage_die "an ITEM is required without a terminal"
    need_gum
    local -a items
    mapfile -t items < <(registered_items)
    [[ ${#items[@]} -gt 0 ]] || die 1 "no registered runs"
    gum choose --header "$1" "${items[@]}" || die 1 "nothing chosen"
}

norm_item() { # $1=raw -> canonical ID on stdout, or die 2
    local item="${1^^}"
    [[ "$item" =~ $ITEM_RE ]] || die 2 "not an item ID: ${1//[[:cntrl:]]/} (${PREFIX_ALT}-<n>)"
    printf '%s' "$item"
}

# ---- build ----

cmd_build() {
    [[ $# -eq 0 ]] || usage_die "build takes no arguments"
    local -a args=(build -t "$IMAGE" -f "$SELF_ROOT/docker/hr/Dockerfile"
        --build-arg "HR_USER=$(id -un)" --build-arg "HR_UID=$(id -u)"
        --build-arg "HR_GID=$(id -g)" --build-arg "HR_HOME=$HOME" "$SELF_ROOT/docker/hr")
    if fancy; then
        gum spin --show-output --title "Building $IMAGE" -- "$DOCKER" "${args[@]}" || die 3 "docker build failed"
    else
        "$DOCKER" "${args[@]}" || die 3 "docker build failed"
    fi
    "$DOCKER" volume create "$CARGO_VOLUME" >/dev/null || die 3 "cannot create volume $CARGO_VOLUME"
    echo "hr: built $IMAGE for $(id -un) ($(id -u):$(id -g), $HOME)"
}

# check_image — present, and built for this host's uid/gid/home (labels).
check_image() {
    local fmt='{{index .Config.Labels "hr.uid"}} {{index .Config.Labels "hr.gid"}} {{index .Config.Labels "hr.home"}}'
    local labels want
    if ! labels="$("$DOCKER" image inspect -f "$fmt" "$IMAGE" 2>/dev/null)"; then
        if interactive; then
            need_gum
            gum confirm "Image $IMAGE not found. Build it now?" || die 2 "image $IMAGE not found — run scripts/hr build"
            cmd_build
            labels="$("$DOCKER" image inspect -f "$fmt" "$IMAGE" 2>/dev/null)" || die 3 "image $IMAGE still missing after build"
        else
            die 2 "image $IMAGE not found — run scripts/hr build"
        fi
    fi
    want="$(id -u) $(id -g) $HOME"
    [[ "$labels" == "$want" ]] \
        || die 2 "image $IMAGE was built for uid/gid/home '$labels', this host is '$want' — rebuild: scripts/hr build"
}

# ---- up ----

UP_RUN_DIR=''
UP_CREATED=0
up_abort() { # $1=rc, rest=message — undo a half-made run dir (before the registry exists)
    local rc="$1"
    shift
    if [[ "$UP_CREATED" -eq 1 && -n "$UP_RUN_DIR" && -d "$UP_RUN_DIR" ]]; then
        rm -rf -- "$UP_RUN_DIR"
    fi
    unlock_runs
    die "$rc" "$@"
}

cmd_up() {
    local item='' ssd=0 ref=main cpus=4 yes=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ssd) ssd=1; shift ;;
            --from) [[ $# -ge 2 ]] || usage_die "--from needs a ref"; ref="$2"; shift 2 ;;
            --cpus) [[ $# -ge 2 ]] || usage_die "--cpus needs a number"; cpus="$2"; shift 2 ;;
            --yes | -y) yes=1; shift ;;
            -h | --help) usage; exit 0 ;;
            -*) usage_die "unknown option for up: $1" ;;
            *) [[ -z "$item" ]] || usage_die "up takes one ITEM"; item="$1"; shift ;;
        esac
    done
    [[ "$cpus" =~ ^[0-9]+(\.[0-9]+)?$ && "$cpus" != 0 ]] || usage_die "--cpus needs a positive number, got '$cpus'"
    [[ -n "$ref" && "$ref" != -* && "$ref" != *[[:cntrl:]]* ]] || usage_die "--from needs a ref, got '$ref'"
    if [[ -n "$item" ]]; then
        item="$(norm_item "$item")" || exit $?
    fi
    host_repo

    # 1. image
    check_image

    # 2. the committed ref the clone takes
    local sha
    sha="$(git -C "$HOST" rev-parse --verify -q "$ref^{commit}")" || die 2 "'$ref' is not a commit in $HOST"

    # 3. the item: open on that commit, no run yet
    local open
    open="$(open_items "$sha")"
    if [[ -z "$item" ]]; then
        interactive || usage_die "an ITEM is required without a terminal"
        need_gum
        local -A have=()
        local i
        while IFS= read -r i; do [[ -n "$i" ]] && have[$i]=1; done < <(registered_items)
        local choices='' id title
        while IFS="$TAB" read -r id title; do
            [[ -z "$id" || -n "${have[$id]:-}" ]] && continue
            choices+="$id  $title"$'\n'
        done <<<"$open"
        [[ -n "$choices" ]] || die 1 "no open items without a run on $ref"
        local pick
        pick="$(printf '%s' "$choices" | gum filter --header "Open items on $ref" \
            --placeholder "type to filter; enter starts a sandbox")" || die 1 "nothing chosen"
        item="$(norm_item "${pick%% *}")" || exit $?
    fi
    awk -F'\t' -v id="$item" '$1 == id { found = 1 } END { exit !found }' <<<"$open" \
        || die 1 "$item is not open on $ref (${sha:0:12}) — only open HANDOFF items get a sandbox"

    # 4. duplicate / leftovers (re-checked under the lock below)
    local root root_kind=hdd
    root="$ROOT_HDD"
    [[ "$ssd" -eq 1 ]] && { root="$ROOT_SSD"; root_kind=ssd; }
    local run_dir="$root/$item"
    [[ -e "$RUNS/$item" ]] && die 1 "run exists for $item — scripts/hr attach $item / scripts/hr down $item"
    [[ -e "$run_dir" ]] && die 1 "stale run dir $run_dir (no registered run) — inspect and remove it by hand"

    # 5. uncommitted workflow files on the host do not travel
    local dirty
    dirty="$(git -C "$HOST" status --porcelain --untracked-files=all -- .claude HANDOFF.md DECISIONS.md 2>/dev/null \
        | grep -vE '^.. \.claude/settings\.local\.json$')"
    if [[ -n "$dirty" ]]; then
        warn "uncommitted workflow files on the host:"
        sed 's/^/  /' <<<"$dirty" >&2
        warn "the clone takes committed $ref only (${sha:0:12})"
        if interactive && [[ "$yes" -eq 0 ]]; then
            need_gum
            gum confirm --default=true "Continue with committed $ref?" || die 1 "cancelled"
        fi
    fi

    # 6. preflight: every host source the compose file mounts, the state dir, leasing on
    local p
    for p in "${LOCAL_MOUNTS[@]}" "$HOME/.claude" "$HOME/.claude.json" "$HOME/.gortex/config.yaml" \
        "$HOME/.gortex/instructions" "$HOME/.gortex/models"; do
        [[ -e "$p" ]] || die 2 "missing $p (the sandbox mounts or copies it)"
    done
    host_env 1
    mkdir -p "$HOME/.headroom" "$HOME/.serena" "$HOME/.cache/uv" "$HOST/.remember" "$RUNS" \
        || die 3 "cannot create the host-side mount sources"
    [[ "$STATE" == "$DEFAULT_STATE" ]] \
        || warn "HR_STATE is non-default: export HR_STATE=$STATE in your shell profile, or host skill mints will not see the leases"
    init_leases
    "$DOCKER" volume create "$CARGO_VOLUME" >/dev/null || die 3 "cannot create volume $CARGO_VOLUME"
    cargo_volume_ok

    # 7. clone, under the runs lock
    lock_runs
    # Ctrl-C / TERM from here to the registry write: the same cleanup as a failed clone.
    trap 'up_abort 130 "interrupted — removed the half-made run dir"' INT
    trap 'up_abort 143 "terminated (interrupted) — removed the half-made run dir"' TERM
    [[ -e "$RUNS/$item" ]] && { unlock_runs; die 1 "run exists for $item — scripts/hr attach $item / scripts/hr down $item"; }
    [[ -e "$run_dir" ]] && { unlock_runs; die 1 "stale run dir $run_dir (no registered run) — inspect and remove it by hand"; }
    mkdir -p "$run_dir" || { unlock_runs; die 3 "cannot create $run_dir"; }
    UP_RUN_DIR="$run_dir"
    UP_CREATED=1
    SRC="$run_dir/src"
    spin "Cloning $HOST" git clone -q --no-hardlinks --no-checkout "$HOST" "$SRC" \
        || up_abort 3 "git clone of $HOST failed"
    clone_git switch -q -c "hr/$item" "$sha" || up_abort 3 "cannot check out hr/$item at ${sha:0:12}"
    # Inside the container the host repo is /host/htui (read-only); the host path is the clone.
    clone_git remote set-url origin /host/htui || up_abort 3 "cannot set origin"
    clone_git config remote.origin.pushurl no-push-from-sandbox || up_abort 3 "cannot set pushurl"
    local exclude="$SRC/.git/info/exclude" gi
    gi="$(global_ignore_file)"
    mkdir -p "${exclude%/*}"
    {
        if [[ -f "$gi" ]]; then
            printf '# host global excludes (%s), copied by scripts/hr up\n' "$gi"
            cat "$gi"
            printf '\n'
        fi
        printf '# copied in by scripts/hr up, untracked\n/.claude/settings.local.json\n'
    } >>"$exclude" || up_abort 3 "cannot write $exclude"
    if [[ -f "$HOST/.claude/settings.local.json" ]]; then
        mkdir -p "$SRC/.claude" && cp -p "$HOST/.claude/settings.local.json" "$SRC/.claude/" \
            || up_abort 3 "cannot copy .claude/settings.local.json"
    fi
    # Mount point of the shared .remember; Docker would create it root-owned.
    mkdir -p "$SRC/.remember" || up_abort 3 "cannot create $SRC/.remember"
    install -m 600 "$HOME/.claude.json" "$run_dir/claude.json" || up_abort 3 "cannot snapshot ~/.claude.json"
    make_cargo_empty "$run_dir" || up_abort 3 "cannot create $run_dir/cargo-empty"
    prepare_claude_mounts "$run_dir" || up_abort 3 "cannot create the ~/.claude mount points or $run_dir/claude-mask"

    # 8. registry before compose, so `down --purge --force` can clean a failed up
    RUN=([item]="$item" [project]="hr-${item,,}" [branch]="hr/$item" [run_dir]="$run_dir"
        [root_kind]="$root_kind" [base_ref]="$ref" [base_sha]="$sha" [cpus]="$cpus"
        [created_at]="$(now_utc)" [collected_sha]='' [collected_at]='')
    write_reg "$item"
    UP_CREATED=0
    trap - INT TERM
    unlock_runs

    # 9. containers
    export HR_ITEM="$item" HR_SRC="$SRC" HR_CLAUDE_JSON="$run_dir/claude.json" HR_CPUS="$cpus"
    export HR_CARGO_EMPTY="$run_dir/cargo-empty" HR_CLAUDE_MASK="$run_dir/claude-mask"
    set_compose "hr-${item,,}"
    spin "Starting $PROJECT" "${COMPOSE[@]}" up -d --wait \
        || die 3 "docker compose up failed for $PROJECT — clean up with: scripts/hr down $item --purge --force"

    # 10.
    echo "hr: $item is up — $run_dir ($root_kind), branch hr/$item from $ref ${sha:0:12}, ${cpus} cpus"
    echo "attach: scripts/hr attach $item"
}

# ---- attach ----

cmd_attach() {
    local item='' shell=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --shell) shell=1; shift ;;
            -h | --help) usage; exit 0 ;;
            -*) usage_die "unknown option for attach: $1" ;;
            *) [[ -z "$item" ]] || usage_die "attach takes one ITEM"; item="$1"; shift ;;
        esac
    done
    if [[ -z "$item" ]]; then
        item="$(pick_run "Attach to which run?")" || exit $?
    fi
    item="$(norm_item "$item")" || exit $?
    load_run "$item" 1
    if ! dev_running; then
        # Runs made before the cargo-empty file existed; and `docker volume prune --all` may have
        # dropped the external cargo volume (both idempotent).
        make_cargo_empty "${RUN[run_dir]}" || die 3 "cannot create ${RUN[run_dir]}/cargo-empty"
        prepare_claude_mounts "${RUN[run_dir]}" \
            || die 3 "cannot create the ~/.claude mount points or ${RUN[run_dir]}/claude-mask"
        "$DOCKER" volume create "$CARGO_VOLUME" >/dev/null || die 3 "cannot create volume $CARGO_VOLUME"
        cargo_volume_ok
        spin "Starting $PROJECT" "${COMPOSE[@]}" up -d --wait || die 3 "docker compose up failed for $PROJECT"
    fi
    local -a tty=()
    [[ -t 0 && -t 1 ]] || tty=(-T)
    if [[ "$shell" -eq 1 ]]; then
        exec "${COMPOSE[@]}" exec "${tty[@]}" -e TERM -e COLORTERM dev bash -l
    fi
    exec "${COMPOSE[@]}" exec "${tty[@]}" -e TERM -e COLORTERM dev claude --dangerously-skip-permissions
}

# ---- ls ----

ls_rows() {
    host_repo
    local main item state ahead disk
    main="$(git -C "$HOST" rev-parse --verify -q 'refs/heads/main^{commit}')"
    printf 'ITEM\tSTATE\tBRANCH\tAHEAD\tDISK\tROOT\n'
    while IFS= read -r item; do
        [[ -n "$item" ]] || continue
        load_run "$item" 0
        if dev_running; then
            state=running
        elif [[ -n "$("${COMPOSE[@]}" ps -a -q 2>/dev/null)" ]]; then
            state=stopped
        else
            state=down
        fi
        is_collected "$item" && state+=+collected
        ahead='?'
        if clone_ok; then
            if [[ -n "$main" ]] && src_git cat-file -e "$main^{commit}" 2>/dev/null; then
                ahead="$(src_git rev-list --count "$main..refs/heads/hr/$item" 2>/dev/null || echo '?')"
            else
                # host main moved to commits the clone never saw: count from the base instead
                ahead="$(src_git rev-list --count "${RUN[base_sha]}..refs/heads/hr/$item" 2>/dev/null || echo '?')*"
            fi
        fi
        disk="$(du -sh "${RUN[run_dir]}" 2>/dev/null | cut -f1)"
        ahead="${ahead//[[:cntrl:]]/}"
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$item" "$state" "${RUN[branch]:-hr/$item}" "$ahead" \
            "${disk:-?}" "${RUN[root_kind]:-?}"
    done < <(registered_items)
}

cmd_ls() {
    local tsv=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tsv) tsv=1; shift ;;
            -h | --help) usage; exit 0 ;;
            *) usage_die "unknown argument for ls: $1" ;;
        esac
    done
    if [[ "$tsv" -eq 1 ]]; then
        ls_rows
        return 0
    fi
    if fancy; then
        local rows
        rows="$(gum spin --show-stdout --title "Measuring runs" -- "$SELF" ls --tsv)" || die 3 "ls failed"
        tail -n +2 <<<"$rows" | gum table -p -s "$TAB" -c ITEM,STATE,BRANCH,AHEAD,DISK,ROOT
    else
        local rows
        rows="$(ls_rows)" || exit $?
        column -t -s "$TAB" <<<"$rows"
    fi
}

# ---- collect / down / gc ----

MERGE_RECIPE='HANDOFF/DECISIONS merge recipe (TOOL-7; the law is .claude/rules/workflow-docs.md):
  1. keep every new checklist line from both sides (IDs are distinct by construction);
  2. take the other side'"'"'s edits to existing lines;
  3. recount the summary table from the merged checklist;
  4. validate-workflow-docs.sh — non-zero means not done.
Then git add the resolved files, git commit --no-edit, and rerun the validator.'

# recipe_prompt ITEM FILES — the prompt for the host claude session that resolves doc conflicts.
recipe_prompt() {
    printf '%s\n' "The merge of branch hr/$1 (a /handoff-run sandbox run) into the current branch stopped on conflicts in: $2." \
        "Resolve them with this fixed recipe, and nothing else:" \
        "1. keep every new checklist line from both sides (IDs are distinct by construction);" \
        "2. take the other side's edits to existing lines;" \
        "3. recount the summary table from the merged checklist;" \
        "4. bash .claude/skills/handoff-run/scripts/validate-workflow-docs.sh — non-zero means not done." \
        "Then git add the resolved files, git commit --no-edit, and rerun the validator. Do not push."
}

cmd_collect() {
    local item='' merge=0 force=0 yes=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --merge) merge=1; shift ;;
            --force) force=1; shift ;;
            --yes | -y) yes=1; shift ;;
            -h | --help) usage; exit 0 ;;
            -*) usage_die "unknown option for collect: $1" ;;
            *) [[ -z "$item" ]] || usage_die "collect takes one ITEM"; item="$1"; shift ;;
        esac
    done
    if [[ -z "$item" ]]; then
        item="$(pick_run "Collect which run?")" || exit $?
    fi
    item="$(norm_item "$item")" || exit $?
    load_run "$item" 0
    local branch="refs/heads/hr/$item"
    clone_ok || die 1 "clone missing at $SRC (or its .git is not a directory)"
    local tip
    tip="$(src_git rev-parse --verify -q "$branch^{commit}")" || die 1 "the clone has no branch hr/$item"

    # --merge preconditions first: a refused merge leaves the host exactly as it was.
    if [[ "$merge" -eq 1 ]]; then
        local dirty
        dirty="$(git -C "$HOST" status --porcelain --untracked-files=no)"
        if [[ -n "$dirty" ]]; then
            sed 's/^/  /' <<<"$dirty" >&2
            die 1 "the host tree has uncommitted tracked changes (above) — commit or stash them before --merge"
        fi
        git -C "$HOST" rev-parse -q --verify MERGE_HEAD >/dev/null \
            && die 1 "a merge is already in progress in $HOST"
        git -C "$HOST" symbolic-ref -q HEAD >/dev/null \
            || die 1 "HEAD is detached in $HOST — check out the branch to merge into"
    fi

    git -C "$HOST" worktree list --porcelain | grep -qxF "branch $branch" \
        && die 1 "hr/$item is checked out in a host worktree — collect cannot move it (switch that worktree away first)"
    local old spec="$branch:$branch"
    old="$(git -C "$HOST" rev-parse --verify -q "$branch")"
    if [[ -n "$old" && "$old" != "$tip" ]] && ! src_git merge-base --is-ancestor "$old" "$tip" 2>/dev/null; then
        [[ "$force" -eq 1 ]] \
            || die 1 "hr/$item was rewritten in the sandbox (host has ${old:0:12}, sandbox ${tip:0:12}); --force overwrites the host branch"
    fi
    [[ "$force" -eq 1 ]] && spec="+$spec"
    # Local fetch: upload-pack runs on the clone but ignores its repo-level packObjectsHook; every
    # object the sandbox made is fsck'd on the way in.
    git -C "$HOST" -c core.hooksPath=/dev/null -c transfer.fsckObjects=true fetch -q --no-tags \
        --no-write-fetch-head --no-recurse-submodules "$SRC" "$spec" || die 3 "git fetch from $SRC failed"
    # What the host now has (the sandbox may have committed since `tip` was read).
    local got
    got="$(git -C "$HOST" rev-parse --verify -q "$branch^{commit}")" || die 3 "hr/$item missing on the host after the fetch"
    set_reg "$item" "collected_sha=$got" "collected_at=$(now_utc)"
    echo "hr: collected hr/$item at ${got:0:12} — commits not on main:"
    { git -C "$HOST" --no-pager log --oneline "refs/heads/main..$branch" 2>/dev/null \
        || git -C "$HOST" --no-pager log --oneline -n 20 "$branch"; } | no_ctl

    [[ "$merge" -eq 1 ]] || return 0

    # Pre-merge, from the host's HEAD: the validator (and what it sources) that judges the merge,
    # and what the run changes in files that drive tools or a claude session on the host. After
    # the merge, both would be the run's own versions (review H6).
    local current vdir f sensitive
    current="$(git -C "$HOST" symbolic-ref --short HEAD)"
    vdir="$(mktemp -d)" || die 3 "cannot create a temp dir"
    trap 'rm -rf -- "$vdir"' EXIT
    for f in validate-workflow-docs.sh workflow-patterns.sh; do
        git -C "$HOST" cat-file blob "HEAD:.claude/skills/handoff-run/scripts/$f" >"$vdir/$f" 2>/dev/null \
            || die 2 "cannot read .claude/skills/handoff-run/scripts/$f at HEAD of $HOST (the merge is validated with it)"
    done
    sensitive="$(git -C "$HOST" --no-pager diff --stat "HEAD...$branch" -- .claude scripts docker 2>/dev/null)"
    if git -C "$HOST" merge --no-ff --no-edit -m "Merge hr/$item (sandbox run)" "$branch"; then
        if ! bash "$vdir/validate-workflow-docs.sh" --repo-root "$HOST"; then
            die 1 "merged hr/$item into $current, but the validator is red — fix before pushing"
        fi
        echo "hr: merged hr/$item into $current. Nothing was pushed."
        return 0
    fi

    local conflicted
    conflicted="$(git -C "$HOST" diff --name-only --diff-filter=U)"
    if [[ -z "$conflicted" ]]; then
        git -C "$HOST" rev-parse -q --verify MERGE_HEAD >/dev/null \
            && die 1 "the merge of hr/$item stopped (see above) — finish it or git merge --abort"
        die 3 "git merge of hr/$item into $current failed (see above); nothing merged"
    fi
    echo "hr: merging hr/$item into $current stopped on conflicts:"
    no_ctl <<<"$conflicted" | sed 's/^/  /'
    local f docs_only=1
    while IFS= read -r f; do
        case "$f" in
            HANDOFF.md | DECISIONS.md | docs/decisions/*) ;;
            *) docs_only=0 ;;
        esac
    done <<<"$conflicted"
    if [[ "$docs_only" -eq 1 ]]; then
        printf '%s\n' "$MERGE_RECIPE"
        local prompt="Open a host claude session primed with this recipe?" ask=0
        if [[ -n "$sensitive" ]] && fancy; then
            # The session starts in the half-merged tree: it loads the run's .claude settings,
            # hooks and skills. Show them; --yes does not answer this one.
            echo "hr: hr/$item changes files that configure or run tools here (pre-merge diff):"
            no_ctl <<<"$sensitive" | sed 's/^/  /'
            prompt="Open a host claude session in the merged tree, with the changes above loaded?"
            ask=1
        fi
        if fancy && { [[ "$yes" -eq 1 && "$ask" -eq 0 ]] || gum confirm "$prompt"; }; then
            (cd "$HOST" && claude "$(recipe_prompt "$item" "$(tr '\n' ' ' <<<"$conflicted")")")
        fi
        die 1 "merge in progress in $HOST — finish it (recipe above) or back out with git merge --abort"
    fi
    die 1 "code conflicts: resolve by hand (git merge --abort to back out)"
}

# purge_blockers ITEM — why a run may not be purged; empty (and 0) when it may. After load_run.
# Any check that cannot run counts as a blocker (fail closed). The worktrees are read only in a
# throwaway container (clone_status_check); everything here on the host is ref/object plumbing.
purge_blockers() {
    local item="$1" out='' st refs wl missing='' detached='' sha name k v wt='' head=''
    if ! clone_ok; then
        printf '  clone missing at %s (or its .git is not a directory)\n' "$SRC"
        return 1
    fi
    is_collected "$item" || out+="  hr/$item is not collected (scripts/hr collect $item)"$'\n'
    st="$(clone_status_check)" \
        || out+="  the clone has uncommitted work (checked in a throwaway container):"$'\n'"$(sed 's/^/    /' <<<"$st")"$'\n'
    src_git rev-parse -q --verify refs/stash >/dev/null \
        && out+="  the clone has stashed changes (refs/stash) — apply and commit them, or drop them"$'\n'
    if refs="$(src_git for-each-ref --format='%(objectname) %(refname:short)' refs/heads)"; then
        while read -r sha name; do
            [[ -z "$sha" || "$name" == "hr/$item" ]] && continue
            git -C "$HOST" cat-file -e "$sha^{commit}" 2>/dev/null || missing+="    $name (${sha:0:12})"$'\n'
        done <<<"$refs"
        [[ -n "$missing" ]] && out+="  clone branches whose tips the host does not have:"$'\n'"$missing"
    else
        out+="  cannot list the clone's branches"$'\n'
    fi
    if wl="$(src_git worktree list --porcelain)"; then
        while read -r k v; do
            case "$k" in
                worktree) wt="$v"; head='' ;;
                HEAD) head="$v" ;;
                detached)
                    [[ -n "$head" ]] && git -C "$HOST" cat-file -e "$head^{commit}" 2>/dev/null \
                        || detached+="    $wt (${head:0:12})"$'\n'
                    ;;
            esac
        done <<<"$wl"
        [[ -n "$detached" ]] && out+="  detached worktree HEADs the host does not have:"$'\n'"$detached"
    else
        out+="  cannot list the clone's worktrees"$'\n'
    fi
    printf '%s' "$out" | no_ctl
    [[ -z "$out" ]]
}

# purge_run ITEM — compose down -v (the external htui-hr-cargo volume is never removed), the run
# dir (guarded), the registry entry. After load_run.
purge_run() {
    local item="$1" rd="${RUN[run_dir]:-}" parent
    [[ -n "$rd" && "${rd##*/}" == "$item" ]] || die 1 "refusing to purge $item: registry run_dir '$rd' does not end in /$item"
    parent="$(realpath -ms "${rd%/*}")"
    [[ "$parent" == "$ROOT_HDD" || "$parent" == "$ROOT_SSD" ]] \
        || die 1 "refusing to purge $item: $rd is not under HR_ROOT ($ROOT_HDD) or HR_SSD_ROOT ($ROOT_SSD)"
    # The rm -rf below must hit the run dir itself: not through a symlink planted at its path, and
    # its parent must physically be the root it claims (read_reg already pinned the spelling).
    [[ -L "$rd" ]] && die 1 "refusing to purge $item: $rd is a symlink (to $(readlink -- "$rd" | no_ctl)) — inspect it by hand"
    if [[ -e "$rd" ]]; then
        [[ -d "$rd" && "$(realpath -e -- "${rd%/*}" 2>/dev/null)" == "$(realpath -e -- "$parent" 2>/dev/null)" ]] \
            || die 1 "refusing to purge $item: $rd is not a directory directly under $parent"
    fi
    spin "Removing $PROJECT" "${COMPOSE[@]}" down -v || die 3 "docker compose down -v failed for $PROJECT"
    if [[ -e "$rd" ]]; then
        rm -rf -- "$rd" 2>/dev/null || { chmod -R u+w -- "$rd" 2>/dev/null; rm -rf -- "$rd"; } \
            || die 3 "cannot remove $rd"
    fi
    lock_runs
    rm -f -- "$RUNS/$item"
    unlock_runs
    echo "hr: purged $item ($rd, containers, volumes)"
}

cmd_down() {
    local item='' purge=0 force=0 yes=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --purge) purge=1; shift ;;
            --force) force=1; shift ;;
            --yes | -y) yes=1; shift ;;
            -h | --help) usage; exit 0 ;;
            -*) usage_die "unknown option for down: $1" ;;
            *) [[ -z "$item" ]] || usage_die "down takes one ITEM"; item="$1"; shift ;;
        esac
    done
    if [[ -z "$item" ]]; then
        item="$(pick_run "Stop which run?")" || exit $?
    fi
    item="$(norm_item "$item")" || exit $?
    load_run "$item" 0
    if [[ "$purge" -eq 0 ]]; then
        spin "Stopping $PROJECT" "${COMPOSE[@]}" down || die 3 "docker compose down failed for $PROJECT"
        echo "hr: $item stopped; clone and volumes kept (scripts/hr up is not needed: attach restarts it)"
        return 0
    fi

    check_leases
    local blockers forced_uncollected=0
    if [[ "$force" -eq 0 ]]; then
        # Stopped first, so nothing in the sandbox changes the clone between the checks and the
        # purge (review M1). A refused purge leaves the run stopped; attach restarts it.
        spin "Stopping $PROJECT" "${COMPOSE[@]}" stop || die 3 "docker compose stop failed for $PROJECT"
        if ! blockers="$(purge_blockers "$item")"; then
            printf '%s' "$blockers" >&2
            die 1 "refusing to purge $item (above; the run is now stopped, attach restarts it); --force overrides"
        fi
    else
        is_collected "$item" || forced_uncollected=1
    fi
    confirm "$yes" "Purge $item: containers, volumes and ${RUN[run_dir]}?" || die 1 "cancelled"
    purge_run "$item"
    if [[ "$forced_uncollected" -eq 1 ]]; then
        HR_STATE="$STATE" "$HR_MINT_BIN" --prune --repo-root "$HOST" --purged-owner "hr/$item" \
            || { warn "scripts/hr-mint --prune failed; leases of hr/$item stay until the next gc"; exit 3; }
    fi
}

cmd_gc() {
    local yes=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes | -y) yes=1; shift ;;
            -h | --help) usage; exit 0 ;;
            *) usage_die "unknown argument for gc: $1" ;;
        esac
    done
    host_repo
    check_leases
    local item
    local -a cands=() chosen=()
    while IFS= read -r item; do
        [[ -n "$item" ]] || continue
        load_run "$item" 0
        dev_running && continue
        purge_blockers "$item" >/dev/null || continue
        cands+=("$item")
    done < <(registered_items)

    if [[ ${#cands[@]} -eq 0 ]]; then
        echo "hr: no stopped, collected, clean runs to purge"
    elif [[ "$yes" -eq 1 ]]; then
        chosen=("${cands[@]}")
    elif interactive; then
        need_gum
        mapfile -t chosen < <(printf '%s\n' "${cands[@]}" | gum choose --no-limit --header "Purge which runs? (stopped, collected, clean)")
    else
        echo "hr: purgeable runs (stopped, collected, clean):"
        printf '  %s\n' "${cands[@]}"
        die 1 "gc needs confirmation: pass --yes (or run it in a terminal)"
    fi
    for item in "${chosen[@]}"; do
        [[ -n "$item" ]] || continue
        load_run "$item" 0
        purge_run "$item"
    done
    HR_STATE="$STATE" "$HR_MINT_BIN" --prune --ref main --repo-root "$HOST" \
        || { warn "scripts/hr-mint --prune failed"; exit 3; }
}

# ---- main ----

VERBS=(build up attach ls collect down gc)

main() {
    [[ "${HR_SANDBOX:-}" == 1 ]] && die 2 "scripts/hr is host-only; this shell is inside a sandbox (HR_SANDBOX=1)"
    local verb="${1:-}"
    [[ $# -gt 0 ]] && shift
    if [[ -z "$verb" ]]; then
        interactive || usage_die
        need_gum
        verb="$(gum choose --header "scripts/hr — /handoff-run sandboxes" "${VERBS[@]}")" || exit 1
    fi
    case "$verb" in
        up | attach | ls | collect | down | gc)
            check_runs_dir
            migrate_registry
            ;;
    esac
    case "$verb" in
        build) cmd_build "$@" ;;
        up) cmd_up "$@" ;;
        attach) cmd_attach "$@" ;;
        ls) cmd_ls "$@" ;;
        collect) cmd_collect "$@" ;;
        down) cmd_down "$@" ;;
        gc) cmd_gc "$@" ;;
        -h | --help | help) usage; exit 0 ;;
        *) usage_die "unknown verb: $verb" ;;
    esac
}

main "$@"
