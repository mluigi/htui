{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT r.key   AS \"key!\",\n                   r.state AS \"state: RequirementState\"\n              FROM item_requirement ir\n              JOIN requirement r ON r.id = ir.requirement_id\n             WHERE ir.item_id = $1 AND ir.requirement_id = $2 AND ir.kind = $3\n               AND ir.deleted_at IS NULL\n               FOR SHARE OF r\n            ",
