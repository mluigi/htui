  "db_name": "PostgreSQL",
  "query": "\n            UPDATE target\n               SET name    = COALESCE($2, name),\n                   locator = COALESCE($3, locator)\n             WHERE id = $1\n            RETURNING id          AS \"id: TargetId\",\n                      name,\n                      kind        AS \"kind: TargetKind\",\n                      locator,\n                      box_id      AS \"box_id: BoxId\",\n                      probed_at,\n                      probe_error,\n                      retired_at,\n                      created_at,\n                      updated_at\n            ",
