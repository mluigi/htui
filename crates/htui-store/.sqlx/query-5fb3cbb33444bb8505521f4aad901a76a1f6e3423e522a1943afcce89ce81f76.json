  "query": "\n                SELECT id AS \"id: MemoryEntryId\", subject\n                  FROM memory_entry\n                 WHERE project_id = $1 AND state IN ('active','suspect')\n                   AND lower(btrim(subject)) = lower(btrim($2::text)) AND id <> $3\n                 ORDER BY id LIMIT 1\n                ",
