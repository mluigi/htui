  "query": "\n            SELECT p.id AS \"project_id: ProjectId\", p.slug, p.name, wp.position\n              FROM workspace_project wp JOIN project p ON p.id = wp.project_id\n             WHERE wp.workspace_id = $1 AND p.id = ANY($2)\n             ORDER BY wp.position\n            ",
