{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT i.id            AS \"id: ItemId\",\n                   i.project_id    AS \"project_id: ProjectId\",\n                   i.kind_id       AS \"kind_id: htui_core::model::ItemKindId\",\n                   i.key_prefix,\n                   i.key_number,\n                   i.key           AS \"key!\",\n                   i.title,\n                   i.body,\n                   i.status        AS \"status: htui_core::model::Status\",\n                   i.priority,\n                   i.required_tags,\n                   i.touched_paths,\n                   i.step_graph_id AS \"step_graph_id: htui_core::model::StepGraphId\",\n                   i.target_id     AS \"target_id: htui_core::model::TargetId\",\n                   i.version,\n                   i.created_by    AS \"created_by: htui_core::model::UserId\",\n                   i.created_at,\n                   i.updated_at,\n                   i.closed_at,\n                   i.resolution    AS \"resolution: htui_core::model::Resolution\"\n              FROM item i\n             WHERE i.project_id = ANY($1)\n               AND (i.status = 'blocked'\n                    OR EXISTS (SELECT 1 FROM run r\n                                WHERE r.item_id = i.id AND r.status = 'awaiting_approval')\n                    OR (i.status = 'open'\n                        AND EXISTS (\n                            SELECT 1 FROM (SELECT r.id, r.status FROM run r\n                                            WHERE r.item_id = i.id AND r.kind = 'graph'\n                                              AND r.status <> 'cancelled'\n                                            ORDER BY r.queued_at DESC, r.id DESC\n                                            LIMIT 1) lr\n                              JOIN integration g ON g.run_id = lr.id\n                             WHERE lr.status = 'done' AND g.state = 'refused')))\n            ",
