  "db_name": "PostgreSQL",
  "query": "\n            SELECT id            AS \"id: BatchId\",\n                   box_id        AS \"box_id: BoxId\",\n                   opened_at,\n                   opened_by     AS \"opened_by: UserId\",\n                   closed_at,\n                   closed_reason AS \"closed_reason: BatchClose\"\n              FROM queue_batch\n             WHERE box_id = $1 AND closed_at IS NOT NULL\n             ORDER BY closed_at DESC, id DESC\n             LIMIT 1\n            ",
