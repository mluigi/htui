  "query": "SELECT from_item_id, to_item_id, kind, proposed_by_step_id, created_at, updated_at, deleted_at FROM item_link WHERE (from_item_id IN (SELECT id FROM item WHERE project_id = $1) OR to_item_id IN (SELECT id FROM item WHERE project_id = $1)) AND updated_at > $2 ORDER BY updated_at",
