  "db_name": "PostgreSQL",
  "query": "\n            SELECT l.collection,\n                   l.lease_box_id,\n                   b.hostname AS \"box_name?\",\n                   l.lease_expires_at,\n                   COALESCE(l.lease_owner IS NOT NULL\n                            AND l.lease_expires_at > clock_timestamp(), false) AS \"live!\"\n              FROM indexer_lease l\n              LEFT JOIN box b ON b.id = l.lease_box_id\n             WHERE l.collection = $1\n            ",
