  "query": "\n                SELECT i.id         AS \"id: ItemId\",\n                       i.project_id AS \"project_id: ProjectId\"\n                  FROM item i JOIN project p ON p.id = i.project_id\n                 WHERE p.slug = $1 AND i.key = $2\n                ",
