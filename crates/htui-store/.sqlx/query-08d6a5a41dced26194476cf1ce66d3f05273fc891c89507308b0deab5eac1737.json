  "query": "\n            UPDATE workspace SET\n                slug        = COALESCE($3, slug),\n                name        = COALESCE($4, name),\n                description = COALESCE($5, description)\n             WHERE id = $1 AND updated_at = $2\n            RETURNING id         AS \"id: WorkspaceId\",\n                      slug,\n                      name,\n                      description,\n                      created_by AS \"created_by: htui_core::model::UserId\",\n                      created_at,\n                      updated_at\n            ",
