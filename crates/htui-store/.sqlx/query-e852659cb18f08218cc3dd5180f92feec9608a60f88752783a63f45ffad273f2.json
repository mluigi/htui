{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id AS \"id: RunId\", graph_snapshot, repo_scope AS \"repo_scope: Vec<RepoId>\"\n              FROM run\n             WHERE executing_box_id = $1 AND status IN ('running','awaiting_approval')\n               AND repo_scope && $2::uuid[]\n             ORDER BY queued_at, id\n            ",
