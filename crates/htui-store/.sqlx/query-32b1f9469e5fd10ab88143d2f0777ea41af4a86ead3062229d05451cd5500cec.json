  "query": "\n            UPDATE step_graph SET\n                name        = COALESCE($3, name),\n                description = COALESCE($4, description)\n             WHERE id = $1 AND updated_at = $2\n            RETURNING id         AS \"id: StepGraphId\",\n                      project_id AS \"project_id: ProjectId\",\n                      name,\n                      description,\n                      created_at,\n                      updated_at\n            ",
