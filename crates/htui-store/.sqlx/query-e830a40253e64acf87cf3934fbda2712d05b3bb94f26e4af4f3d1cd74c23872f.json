  "query": "\n            SELECT a.project_id AS \"project_id: ProjectId\",\n                   a.code,\n                   p.owner_workspace_id IS NOT NULL AS \"scope_row!\"\n              FROM requirement_area a\n              JOIN project p ON p.id = a.project_id\n             WHERE a.id = $1\n            ",
