  "query": "\n            SELECT s.status  AS \"step_status: StepStatus\",\n                   r.id      AS \"run_id: RunId\",\n                   r.status  AS \"run_status: RunStatus\"\n              FROM run_step s JOIN run r ON r.id = s.run_id\n             WHERE s.id = $1\n               FOR UPDATE OF s, r\n            ",
