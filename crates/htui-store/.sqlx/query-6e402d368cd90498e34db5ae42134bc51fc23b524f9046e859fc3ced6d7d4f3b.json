  "query": "\n            SELECT w.id         AS \"id: WorkspaceId\",\n                   w.slug,\n                   w.name,\n                   w.created_by AS \"created_by: UserId\"\n              FROM workspace w\n             WHERE NOT EXISTS (SELECT 1 FROM project p WHERE p.owner_workspace_id = w.id)\n             ORDER BY w.id\n               FOR SHARE OF w\n            ",
