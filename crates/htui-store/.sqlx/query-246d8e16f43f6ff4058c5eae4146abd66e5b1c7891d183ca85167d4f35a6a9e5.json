{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT r.id    AS \"run: RunId\",\n                   ws.mode AS \"mode: StopMode\"\n              FROM workspace_stop ws\n              JOIN run r ON r.workspace_id = ws.workspace_id\n             WHERE r.status = 'running' AND r.lease_owner = $1\n             ORDER BY r.queued_at, r.id\n            ",
