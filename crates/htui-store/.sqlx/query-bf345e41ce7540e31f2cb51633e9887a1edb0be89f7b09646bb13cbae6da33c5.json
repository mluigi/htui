  "db_name": "PostgreSQL",
  "query": "\n        SELECT pp.phase_id   AS \"phase_id: PhaseId\",\n               pp.position,\n               pp.key,\n               pp.title,\n               pp.brief,\n               pp.owned_paths,\n               pp.acceptance,\n               pp.agent_id   AS \"agent_id: AgentId\",\n               pp.model,\n               pp.persona_id AS \"persona_id: PersonaId\"\n          FROM phase_part pp\n          JOIN step_graph_phase p ON p.id = pp.phase_id\n         WHERE p.graph_id = $1\n         ORDER BY p.position, pp.position\n        ",
