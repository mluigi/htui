  "query": "\n                SELECT pr.slug AS \"project!\", g.name AS \"graph!\", p.name AS \"phase!\"\n                  FROM step_graph_phase p\n                  JOIN step_graph g ON g.id = p.graph_id\n                  JOIN project pr ON pr.id = g.project_id\n                 WHERE p.persona_id = $1\n                ",
