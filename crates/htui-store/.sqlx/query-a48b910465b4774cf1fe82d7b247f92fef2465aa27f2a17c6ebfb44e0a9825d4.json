  "query": "\n            SELECT l.from_item_id AS \"from_item_id: ItemId\",\n                   l.to_item_id   AS \"to_item_id: ItemId\",\n                   l.kind         AS \"kind: LinkKind\"\n              FROM item_link l\n             WHERE l.deleted_at IS NULL\n               AND l.from_item_id = ANY($1) AND l.to_item_id = ANY($1)\n            ",
