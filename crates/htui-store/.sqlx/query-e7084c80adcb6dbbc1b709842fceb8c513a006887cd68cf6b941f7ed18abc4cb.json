  "query": "\n            SELECT e.item_id    AS \"item_id: ItemId\",\n                   i.project_id AS \"project_id: ProjectId\",\n                   e.box_id     AS \"box_id: BoxId\",\n                   e.position,\n                   e.queued_at,\n                   e.queued_by  AS \"queued_by: UserId\"\n              FROM queue_entry e JOIN item i ON i.id = e.item_id\n             WHERE e.item_id = $1\n            ",
