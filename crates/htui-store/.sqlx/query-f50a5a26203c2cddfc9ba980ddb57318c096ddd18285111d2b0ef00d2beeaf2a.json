  "query": "\n            UPDATE skill SET\n                name        = COALESCE($3, name),\n                description = COALESCE($4, description)\n             WHERE id = $1 AND updated_at = $2\n            RETURNING id         AS \"id: SkillId\",\n                      name,\n                      description,\n                      created_by AS \"created_by: UserId\",\n                      created_at,\n                      updated_at\n            ",
