  "query": "\n        SELECT a.phase_id AS \"phase_id: PhaseId\",\n               a.position,\n               a.agent_id AS \"agent_id: AgentId\",\n               a.model\n          FROM phase_agent a\n          JOIN step_graph_phase p ON p.id = a.phase_id\n         WHERE p.graph_id = $1\n         ORDER BY p.position, a.position\n        ",
