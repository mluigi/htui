{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id         AS \"id: DocumentId\",\n               project_id AS \"project_id: ProjectId\",\n               item_id    AS \"item_id: ItemId\"\n          FROM document\n         WHERE kind = $3\n           AND (item_id = $2::uuid\n                OR ($2::uuid IS NULL AND item_id IS NULL AND project_id = $1::uuid))\n           AND ($4::int IS NULL OR version = $4::int)\n         ORDER BY version DESC\n         LIMIT 1\n        ",
