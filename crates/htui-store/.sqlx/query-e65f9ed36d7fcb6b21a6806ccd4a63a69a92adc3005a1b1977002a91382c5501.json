  "db_name": "PostgreSQL",
  "query": "\n                    SELECT id          AS \"id!\",\n                           box_id      AS \"box_id?: BoxId\",\n                           box_name    AS \"box_name!\",\n                           logged_at   AS \"logged_at!\",\n                           received_at AS \"received_at!\",\n                           level       AS \"level!: WorkerLogLevel\",\n                           target      AS \"target!\",\n                           text        AS \"text!\"\n                      FROM worker_log\n                     WHERE user_id = $1 AND id > $2\n                     ORDER BY id\n                     LIMIT $3\n                    ",
