  "query": "\n            SELECT id     AS \"id: RunId\",\n                   status AS \"status: RunStatus\"\n              FROM run\n             WHERE item_id = $1 AND status IN ('queued','running','awaiting_approval')\n             ORDER BY queued_at, id\n             LIMIT 1\n            ",
