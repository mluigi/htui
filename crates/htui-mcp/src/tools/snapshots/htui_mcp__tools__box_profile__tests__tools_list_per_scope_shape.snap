    {
      "name": "item_link",
      "description": "Proposes or withdraws a link from this step's item to another item of its project or its workspaces, named by key: FEAT-12 here, api:FEAT-12 in project api, @shop:WS-1 for workspace shop's own items.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "remove"
            ],
            "description": "`add` proposes the link, `remove` withdraws one this run proposed."
          },
          "to": {
            "type": "string",
            "description": "The other item's key: `FEAT-12` in this project, `api:FEAT-12` in project `api`, or `@shop:WS-1` for workspace `shop`'s own item."
          },
          "kind": {
            "type": "string",
            "enum": [
              "blocked_by",
              "origin",
              "relates",
              "supersedes",
              "parent",
              "duplicates",
              "implements"
            ],
            "description": "How this item relates to `to`, read `<this item> <kind> <to>`: `blocked_by`: this item cannot start until `to` is finished; `origin`: this item was spawned by `to`; `relates`: see also; `supersedes`: this item replaces `to`; `parent`: this item is a part of `to`; `duplicates`: this item is the same as `to`; `implements`: this item carries out `to`'s decision. An item has at most one `parent` and one `duplicates`."
          }
        },
        "required": [
          "op",
          "to",
          "kind"
        ],
        "title": "LinkArgs"
