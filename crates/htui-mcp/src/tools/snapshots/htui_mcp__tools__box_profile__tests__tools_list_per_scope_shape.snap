        "additionalProperties": false,
        "title": "BoxProfileArgs"
      }
    },
    {
      "name": "document_write",
      "description": "Records this step's output document; each call writes a new version.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": [
