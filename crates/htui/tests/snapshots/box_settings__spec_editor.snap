---
probe spec: seed + stored overlay · <digest>
stored overlay, merged into the seed by tool name; blank clears it
{
  "tools": {
    "terraform": {
      "kind": "path",
      "names": [
        "terraform"
      ],
      "version": {
        "args": [
          "version"
        ],
        "pattern": "^Terraform v(\\S+)"
      }
    }
  }
}
